{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for UnionCrax.Direct",
  "windows": ["main", "auth"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-lstat",
    "fs:scope-app-recursive",
    "fs:scope-download-recursive",
    "fs:scope-home-recursive",
    "http:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "shell:allow-spawn",
    "shell:allow-execute",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "updater:allow-check",
    "updater:allow-download-and-install"
  ]
}
